{
  "expo": {
    "name": "Tayar.ai",
    "slug": "tayar-ai",
    "version": "0.2.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "ai.tayar.adaptive",
      "versionCode": 3,
      "permissions": []
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "tayarai"
  }
}
